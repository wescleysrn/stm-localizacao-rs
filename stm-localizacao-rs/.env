# =========================================================
# CONFIGURAÇÕES DO DOCKER & CONTAINER
# =========================================================
DOCKER_IMAGE_NAME=wescleymacedosousa/stm-localizacao-rs
DOCKER_IMAGE_TAG=1.0.0
CONTAINER_PORT=8080
HOST_PORT=8080

# =========================================================
# CONFIGURAÇÕES DA APLICAÇÃO SPRING BOOT
# =========================================================
SPRING_PROFILES_ACTIVE=prod
RESOURCE_SERVER_PORT=8080

# Banco de Dados (Padrão H2 em memória)
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_DATASOURCE_URL=jdbc:h2:mem:db-localizacao;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=sa
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_WEB_ALLOW_OTHERS=true

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DIALECT=org.hibernate.dialect.H2Dialect
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_SQL_INIT_MODE=always

# Logs
LOGGING_SPRING_WEB=INFO
LOGGING_SPRING_BOOT=INFO
LOGGING_SPRING_SECURITY=INFO
LOGGING_SPRING_ORM_JPA=INFO
LOGGING_HIBERNATE_SQL=INFO

# Documentação & Monitoramento
SWAGGER_ENABLED=true
MONITORING_ENDPOINTS=health,metrics,info,prometheus
MONITORING_PROMETHEUS=true
